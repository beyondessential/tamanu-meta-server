# `openapi-typescript` peer-pins TypeScript ^5 but we use TS 6. The tool is a
# CLI binary that ships its own bundled TS — its peer-dep is purely advisory,
# and the version mismatch doesn't bite at runtime. Centralising the
# `--legacy-peer-deps` opt-in here means CI, `private-server/build.rs`, and
# manual `npm install` invocations all behave the same.
#
# Drop this file once openapi-typescript widens its TS peer range:
#   https://github.com/openapi-ts/openapi-typescript/issues/2723
legacy-peer-deps=true
